# Modèle de config/secrets.env — copié par le setup, jamais versionné.
# Une variable par ligne, sans guillemets. Laissez vide ce que vous n'utilisez pas.

# France Travail (API Offres d'emploi v2) : créez une application sur https://francetravail.io
# Rempli lors de la première collecte avec la source france_travail.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Airtable : jeton d'accès personnel, uniquement si storage.backend vaut airtable.
# Rempli lors de la création de la base par le setup.
AIRTABLE_API_KEY=
